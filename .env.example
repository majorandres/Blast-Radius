# Postgres superuser (migrations run as this role; it owns every table)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=blastradius

# Role passwords -- three roles, one database (v1.2 §3.9)
BLASTRADIUS_APP_PASSWORD=app
BLASTRADIUS_DETECTOR_PASSWORD=detector
BLASTRADIUS_SCENARIO_PASSWORD=scenario

# Required (Day 1 config contract)
DATABASE_URL_APP=postgresql+asyncpg://blastradius_app:app@postgres:5432/blastradius
DATABASE_URL_DETECTOR=postgresql+asyncpg://blastradius_detector:detector@postgres:5432/blastradius
DATABASE_URL_SCENARIO=postgresql+asyncpg://blastradius_scenario:scenario@postgres:5432/blastradius
OBSERVABILITY_INGEST_URL=http://observability-service:8004/internal/spans
PROMO_PROVIDER_URL=http://promo-provider:8002

# Optional
TRAFFIC_ENABLED=true
TRAFFIC_BASE_RATE_PER_MIN=150
TRAFFIC_SEED=42
TRAFFIC_MAX_CONCURRENCY=40
OTLP_ENDPOINT=http://jaeger:4318
DB_POOL_SIZE=10
DB_POOL_TIMEOUT=5
PROMO_CLIENT_TIMEOUT_MS=2000

# Migration / bootstrap (one-shot)
DATABASE_URL_MIGRATE=postgresql://postgres:postgres@postgres:5432/blastradius
